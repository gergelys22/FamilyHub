{
  "expo": {
    "name": "FamilyHub",
    "slug": "FamilyHub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "familyhub",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCd_6acRhQPSyS6IGtDLyBz1pY48SH4pBE"
        }
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.gergely2002.FamilyHub"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "A FamilyHub a Face ID-t használhatja az érzékeny képernyők feloldásához."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "A FamilyHub a mikrofon használhatja hangüzenetek rögzítéséhez."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "A FamilyHub hozzáférést kér a profilképed kiválasztásához.",
          "cameraPermission": "A FamilyHub hozzáférést kér profilkép készítéséhez.",
          "microphonePermission": false
        }
      ],
      "expo-asset",
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ab7f1f72-7165-4b08-b84e-a6df9d919486"
      }
    }
  }
}
